<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- For GIPHY search, only while its screen is open. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ hides other apps unless asked; these let RetroDeck find a file picker. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.CREATE_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application>
        <!-- Exported only so a branding pack can be opened or shared here from another app (LocalSend,
             a file manager, a chat app). It asks before importing, and every pack is checked. -->
        <activity android:name=".VehicleBrandingActivity" android:theme="@style/RetroDeck.Theme"
            android:exported="true" android:label="Import into RetroDeck"
            android:screenOrientation="sensorLandscape" android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
        </activity>
        <activity android:name=".SkinGalleryActivity" android:theme="@style/RetroDeck.Theme"
            android:exported="false" />
        <activity android:name=".LogoEditorActivity" android:theme="@style/RetroDeck.Theme"
            android:screenOrientation="sensorLandscape" android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".PlacementEditorActivity" android:theme="@style/RetroDeck.Theme"
            android:screenOrientation="sensorLandscape" android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".StartupEditorActivity" android:theme="@style/RetroDeck.Theme"
            android:screenOrientation="sensorLandscape" android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".GiphyActivity" android:theme="@style/RetroDeck.Theme"
            android:screenOrientation="sensorLandscape" android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".BrandingPreviewActivity" android:theme="@style/RetroDeck.Theme"
            android:screenOrientation="sensorLandscape" android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>
</manifest>
